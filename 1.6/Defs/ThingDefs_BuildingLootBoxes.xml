                <useJob>UseItem</useJob>
                <useLabel>Open {0}</useLabel>
            </li>
            <li Class="FCP.Core.CompProperties_UseEffectItemBox">
                <numWeightedDrops>2</numWeightedDrops>
                <guaranteedDrops>
                </guaranteedDrops>
                <weightedDrops>
                    <li>
                        <thingDef>guy762_KotORcredits</thingDef>
                        <countRange>10~100</countRange>
                        <weight>1</weight>
                    </li>
					<li>
                        <thingDef>MealNutrientPaste</thingDef>
                        <countRange>1</countRange>
						<weight>1</weight>
                    </li>
					
					
					<li>
                        <thingDef>Pemmican</thingDef>
                        <countRange>5~10</countRange>
                        <weight>0.5</weight>
                    </li>
					<li>
                        <thingDef>ComponentIndustrial</thingDef>
                        <countRange>1</countRange>
                        <weight>0.5</weight>
                    </li>
					<li>
                        <thingDef>Cloth</thingDef>
                        <countRange>2~4</countRange>
                        <weight>0.5</weight>
                    </li>
					<li>
                        <thingDef>Neutroamine</thingDef>
                        <countRange>1~2</countRange>
                        <weight>0.5</weight>
                    </li>
					<li>
                        <thingDef>Beer</thingDef>
                        <countRange>1</countRange>
                        <weight>0.5</weight>
                    </li>
					
					
					<li>
                        <thingDef>KOTOR_Deathstick</thingDef>
                        <countRange>1~2</countRange>
                        <weight>0.25</weight>
                    </li>
					<li>
                        <thingDef>guy762_medpac</thingDef>
                        <countRange>1~2</countRange>
                        <weight>0.25</weight>
                    </li>
					<li>
                        <thingDef>Chocolate</thingDef>
                        <countRange>1</countRange>
                        <weight>0.25</weight>
                    </li>
					<li>
                        <thingDef>Synthread</thingDef>
                        <countRange>2~4</countRange>
                        <weight>0.25</weight>
                    </li>
					<li>
                        <thingDef>KOTOR_PlasmaCartridge</thingDef>
                        <countRange>1</countRange>
                        <weight>0.25</weight>
                    </li>
					
					
					<li>
                        <thingDef>ComponentSpacer</thingDef>
                        <countRange>1</countRange>
                        <weight>0.1</weight>
                    </li>
					<li>
                        <thingDef>KOTOR_FabricArmorweave</thingDef>
                        <countRange>2~4</countRange>
                        <weight>0.1</weight>
                    </li>
					<li MayRequire="Mlie.StarWarsAnimalCollection">
                        <thingDef>TarisianAle</thingDef>
                        <countRange>1</countRange>
                        <weight>0.1</weight>
                    </li>
					<li>
                        <thingDef>KOTOR_Spice</thingDef>
                        <countRange>1~2</countRange>
                        <weight>0.1</weight>
                    </li>
					
					<li>
                        <thingDef>KOTOR_kolto</thingDef>
                        <countRange>1</countRange>
                        <weight>0.05</weight>
                    </li>
					<li>
                        <thingDef>guy762_KotORcredits</thingDef>
                        <countRange>100~500</countRange>
                        <weight>0.05</weight>
                    </li>
